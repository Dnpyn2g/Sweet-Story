# Generated by build.py — kept in git so GitHub Pages branch-deploy serves them.
# The CI workflow (.github/workflows/deploy.yml) regenerates and commits them
# on every push; you can also run `python build.py` locally before pushing.

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Editors
.vscode/
.idea/

# Local state / secrets — do not commit
state.json
posting.log
logs/
uploads/
